generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =======================
//         ENUMS
// =======================

enum UserRole {
  user
  admin
  painter
  vendor
}

enum PainterService {
  indoor
  outdoor
  both
}

enum PaintBase {
  water
  oil
  wood
}

enum PaintFinish {
  matte
  semi_gloss
  gloss
}

enum PaintUnit {
  liter
  kg
}

enum PaintUsage {
  indoor
  outdoor
  both
}

enum OrderStatus {
  pending
  accepted
  rejected
  completed
}

enum OfferDiscountType {
  percentage
  fixed
}

// =======================
//         Onboarding
// =======================

model Onboarding {
  id          Int    @id @default(autoincrement())
  title       String
  description String
  imageUrl    String
  order       Int
}

// =======================
//         USER
// =======================

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  phone     String   @unique
  role      UserRole @default(user)
  createdAt DateTime @default(now())

  painter      Painter?
  vendor       Vendor?
  cart         Cart?
  favorites    FavoriteColor[]
  orders       Order[]
  painterVisit PainterVisit[]
  reviews      PainterReview[]
}

// =======================
//         VENDOR
// =======================

model Vendor {
  id              Int     @id @default(autoincrement())
  userId          Int     @unique
  shopName        String
  taxRegistration String
  companyType     String
  isApproved      Boolean @default(false)
  city            String
  address         String?

  user   User    @relation(fields: [userId], references: [id])
  paints Paint[]
}

// =======================
//         PAINTER
// =======================

model Painter {
  id         Int            @id @default(autoincrement())
  userId     Int            @unique
  rating     Float          @default(0)
  experience Int
  city       String
  address    String?
  service    PainterService

  user    User             @relation(fields: [userId], references: [id])
  gallery PainterGallery[]
  reviews PainterReview[]
  visits  PainterVisit[]
}

model PainterVisit {
  id        Int         @id @default(autoincrement())
  userId    Int
  painterId Int
  visitDate DateTime
  area      Float
  city      String
  region    String
  status    OrderStatus @default(pending)

  user    User    @relation(fields: [userId], references: [id])
  painter Painter @relation(fields: [painterId], references: [id])
}

// =======================
//         CATEGORIES
// =======================

model Category {
  id          Int           @id @default(autoincrement())
  name        String        @unique
  paints      Paint[]
  SubCategory SubCategory[]
}

model SubCategory {
  id         Int      @id @default(autoincrement())
  name       String
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])
  paints     Paint[]
}

// =======================
//         PAINT
// =======================

model Paint {
  id            Int         @id @default(autoincrement())
  name          String
  description   String?
  price         Float
  stock         Int
  image         String?
  coverage      Float
  coatHours     Int
  dryDays       Int
  base          PaintBase
  finish        PaintFinish
  unit          PaintUnit
  usage         PaintUsage
  vendorId      Int
  categoryId    Int
  subCategoryId Int?

  vendor      Vendor       @relation(fields: [vendorId], references: [id])
  category    Category     @relation(fields: [categoryId], references: [id])
  subCategory SubCategory? @relation(fields: [subCategoryId], references: [id])
  cartItems   CartItem[]
  orderItems  OrderItem[]
}

// =======================
//         CART
// =======================

model Cart {
  id     Int        @id @default(autoincrement())
  userId Int        @unique
  user   User       @relation(fields: [userId], references: [id])
  items  CartItem[]
}

model CartItem {
  id       Int @id @default(autoincrement())
  cartId   Int
  paintId  Int
  quantity Int @default(1)

  cart  Cart  @relation(fields: [cartId], references: [id])
  paint Paint @relation(fields: [paintId], references: [id])
}

// =======================
//         ORDER
// =======================

model Order {
  id         Int         @id @default(autoincrement())
  userId     Int
  painterId  Int?
  totalPrice Float
  status     OrderStatus @default(pending)
  createdAt  DateTime    @default(now())
  user       User        @relation(fields: [userId], references: [id])
  items      OrderItem[]
}

model OrderItem {
  id       Int @id @default(autoincrement())
  orderId  Int
  paintId  Int
  quantity Int

  order Order @relation(fields: [orderId], references: [id])
  paint Paint @relation(fields: [paintId], references: [id])
}

// =======================
//         FAVORITES
// =======================

model FavoriteColor {
  id        Int    @id @default(autoincrement())
  userId    Int
  colorCode String
  user      User   @relation(fields: [userId], references: [id])
}

// =======================
//         PAINTER MEDIA
// =======================

model PainterGallery {
  id        Int     @id @default(autoincrement())
  painterId Int
  imageUrl  String
  painter   Painter @relation(fields: [painterId], references: [id])
}

model PainterReview {
  id        Int      @id @default(autoincrement())
  painterId Int
  userId    Int
  rating    Float
  review    String
  createdAt DateTime @default(now())

  painter Painter @relation(fields: [painterId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
}

// =======================
//         OFFERS
// =======================

model Offer {
  id           Int               @id @default(autoincrement())
  title        String
  discount     Float
  discountType OfferDiscountType
  isActive     Boolean           @default(true)
}

// =======================
//         COLOR SYSTEM
// =======================

model ColorSystem {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  colors Color[]
}

model Color {
  id            Int         @id @default(autoincrement())
  code          String
  rgb           String?
  hex           String?
  colorSystemId Int
  colorSystem   ColorSystem @relation(fields: [colorSystemId], references: [id])
}
