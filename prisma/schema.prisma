generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model auditlog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  details   String   @db.Text
  createdAt DateTime @default(now())

  @@index([userId], map: "AuditLog_userId_fkey")
  @@index([action], map: "AuditLog_action_idx")
  @@index([createdAt], map: "AuditLog_createdAt_idx")
}

model attribute {
  id   Int    @id @default(autoincrement())
  name String
}

model cart {
  id       Int @id @default(autoincrement())
  userId   Int
  paintId  Int
  quantity Int @default(1)

  @@index([paintId], map: "Cart_paintId_fkey")
  @@index([userId], map: "Cart_userId_fkey")
}

model category {
  id          Int     @id @default(autoincrement())
  name        String  @unique(map: "Category_name_key")
  description String?
}

model chatmessage {
  id        Int      @id @default(autoincrement())
  userId    Int
  message   String
  response  String
  createdAt DateTime @default(now())

  @@index([userId], map: "ChatMessage_userId_fkey")
}

model designerprofile {
  id          Int     @id @default(autoincrement())
  userId      Int     @unique(map: "DesignerProfile_userId_key")
  experience  Int?
  specialties String?
  rating      Float?
  portfolio   String?
}

model design {
  id         Int       @id @default(autoincrement())
  designerId Int
  title      String
  description String  @db.Text
  imageUrl   String
  videoUrl   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([designerId], map: "Design_designerId_fkey")
  @@map("design")
}

model designcomment {
  id        Int      @id @default(autoincrement())
  designId  Int
  userId    Int
  text      String   @db.Text
  createdAt DateTime @default(now())

  @@index([designId], map: "DesignComment_designId_fkey")
  @@index([userId], map: "DesignComment_userId_fkey")
  @@map("design_comment")
}

model designfavorite {
  userId   Int
  designId Int

  @@id([userId, designId])
  @@index([designId], map: "DesignFavorite_designId_fkey")
  @@map("design_favorite")
}

model designrequest {
  id          Int      @id @default(autoincrement())
  designId    Int
  clientUserId Int
  description String  @db.Text
  imageUrl    String?
  videoUrl    String?
  status      String   @default("pending")
  createdAt   DateTime @default(now())

  @@index([designId], map: "DesignRequest_designId_fkey")
  @@index([clientUserId], map: "DesignRequest_clientUserId_fkey")
  @@map("design_request")
}

model favoritecolor {
  id        Int     @id @default(autoincrement())
  userId    Int
  colorCode String
  name      String?

  @@index([userId], map: "FavoriteColor_userId_fkey")
}

model favoriteproduct {
  userId  Int
  paintId Int

  @@id([userId, paintId])
  @@index([paintId], map: "FavoriteProduct_paintId_fkey")
}

model offer {
  id           Int                @id @default(autoincrement())
  title        String
  discount     Float
  isActive     Boolean            @default(true)
  startDate    DateTime
  endDate      DateTime
  discountType offer_discountType
}

model order {
  id          Int       @id @default(autoincrement())
  userId      Int
  painterId   Int?
  totalPrice  Float
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  area        Float?
  serviceDate DateTime?
  serviceTime String?
  zone        String?

  @@index([painterId], map: "Order_painterId_fkey")
  @@index([userId], map: "Order_userId_fkey")
}

model visitrequest {
  id            Int      @id @default(autoincrement())
  clientUserId  Int
  painterId     Int
  scheduledDate DateTime // التاريخ
  scheduledTime String   // الوقت
  area          Float?   // المساحة (متر مربع)
  address       String   @db.Text // العنوان
  status        String   @default("pending") // pending, accepted, rejected, completed
  createdAt     DateTime @default(now())
  notes         String?  @db.Text

  @@index([clientUserId], map: "VisitRequest_clientUserId_fkey")
  @@index([painterId], map: "VisitRequest_painterId_fkey")
  @@map("visit_request")
}

model orderitem {
  id       Int @id @default(autoincrement())
  orderId  Int
  paintId  Int
  quantity Int @default(1)

  @@index([orderId], map: "OrderItem_orderId_fkey")
  @@index([paintId], map: "OrderItem_paintId_fkey")
}

model otp {
  id        Int      @id @default(autoincrement())
  phone     String
  code      String
  expiresAt DateTime
  used      Boolean  @default(false)
}

model Paint {
  id          Int          @id @default(autoincrement())
  name        String
  price       Float
  description String?

  categoryId  Int
  vendorId    Int

  base        paint_base
  coatHours   Int
  coverage    Float
  dryDays     Int
  finish      paint_finish
  unit        paint_unit
  usage       paint_usage

  image       String?
  stock       Int
  inStock     Boolean      @default(true)
  isActive    Boolean      @default(true)
  weightKg    Float?       @default(1)

  offerId     Int?
  type        String

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("paint")
  @@index([categoryId])
  @@index([vendorId])
  @@index([offerId])
}

model paintattribute {
  paintId     Int
  attributeId Int

  @@id([paintId, attributeId])
  @@index([attributeId], map: "PaintAttribute_attributeId_fkey")
}

model painter {
  id          Int     @id @default(autoincrement())
  rating      Float   @default(0)
  experience  Int
  address     String?
  city        String
  serviceType String
  userId      Int     @unique(map: "Painter_userId_key")
}

model paintergallery {
  id        Int    @id @default(autoincrement())
  painterId Int
  imageUrl  String

  @@index([painterId], map: "PainterGallery_painterId_fkey")
}

model painterreview {
  id        Int      @id @default(autoincrement())
  painterId Int
  userId    Int
  review    String
  rating    Float
  createdAt DateTime @default(now())

  @@index([painterId], map: "PainterReview_painterId_fkey")
  @@index([userId], map: "PainterReview_userId_fkey")
}

model selection {
  id                  Int      @id @default(autoincrement())
  userId              Int
  paintId             Int
  createdAt           DateTime @default(now())
  area                Float
  height              Float?
  length              Float?
  recommendedQuantity Int
  width               Float?
  colorCode           String?
  imagePath           String?

  @@index([paintId], map: "Selection_paintId_fkey")
  @@index([userId], map: "Selection_userId_fkey")
}

model subcategory {
  id         Int    @id @default(autoincrement())
  name       String
  categoryId Int

  @@index([categoryId], map: "SubCategory_categoryId_fkey")
}

model user {
  id        Int       @id @default(autoincrement())
  name      String
  email     String    @unique(map: "User_email_key")
  password  String
  phone     String    @unique(map: "User_phone_key")
  role      user_role @default(user)
  createdAt DateTime  @default(now())
}

model usercategory {
  id         Int @id @default(autoincrement())
  userId     Int
  categoryId Int

  @@unique([userId, categoryId], map: "UserCategory_userId_categoryId_key")
  @@index([categoryId], map: "UserCategory_categoryId_fkey")
}

model vendor {
  id               Int      @id @default(autoincrement())
  userId           Int      @unique(map: "Vendor_userId_key")
  shopName         String
  city             String
  address          String?
  region           String?
  taxRegistration  String?
  isApproved       Boolean  @default(true)
  paymentStatus    Boolean  @default(false)
}

model ColorSystem {
  id    Int    @id @default(autoincrement())
  name  String
  slug  String? @unique
  colors SystemColor[]

  @@map("color_system")
}

model SystemColor {
  id            Int         @id @default(autoincrement())
  colorSystemId Int
  code          String
  hex           String
  labL          Float?
  labA          Float?
  labB          Float?
  colorSystem   ColorSystem @relation(fields: [colorSystemId], references: [id], onDelete: Cascade)

  @@index([colorSystemId])
  @@map("system_color")
}

enum user_role {
  user
  admin
  painter
  vendor
  designer
}

enum offer_discountType {
  percentage
  fixed
}

enum paint_base {
  water
  oil
  wood
}

enum paint_finish {
  matte
  semi_gloss
  gloss
}

enum paint_unit {
  liter
  kg
}

enum paint_usage {
  indoor
  outdoor
  both
}
